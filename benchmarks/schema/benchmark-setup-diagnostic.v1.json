{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pliego.dev/schema/benchmark-setup-diagnostic.v1.json",
  "title": "Pliego benchmark setup diagnostic v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "status", "phase", "exit_code", "generated_at", "repository",
    "revision", "run_id", "run_attempt", "job", "workflow_ref", "runner_os", "runner_arch"
  ],
  "properties": {
    "schema": { "const": "pliego.benchmark-setup-diagnostic" },
    "version": { "const": 1 },
    "status": { "enum": ["started", "failed", "passed"] },
    "phase": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "exit_code": { "type": ["integer", "null"] },
    "generated_at": { "type": "string", "minLength": 1 },
    "repository": { "type": "string", "minLength": 1 },
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "run_id": { "type": "integer", "minimum": 1 },
    "run_attempt": { "type": "integer", "minimum": 1 },
    "job": { "type": "string", "minLength": 1 },
    "workflow_ref": { "type": "string", "minLength": 1 },
    "runner_os": { "type": "string", "minLength": 1 },
    "runner_arch": { "type": "string", "minLength": 1 }
  }
}
