{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pliego.dev/schema/benchmark-hosted-comparison.v1.json",
  "title": "Pliego GitHub-hosted comparative benchmark",
  "description": "A directional, non-dedicated comparison bound to an exact interleaved raw-sample artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "evidence_class",
    "publication_status",
    "claim_boundary",
    "comparison_sha256",
    "generated_at",
    "source",
    "runner",
    "host",
    "ambient",
    "protocol",
    "fixture",
    "oracle",
    "targets",
    "interleaved_artifact",
    "aggregates",
    "evidence_binding"
  ],
  "properties": {
    "schema": { "const": "pliego.benchmark-hosted-comparison" },
    "version": { "const": 1 },
    "evidence_class": { "const": "github-hosted-exploratory" },
    "publication_status": { "const": "hosted-snapshot" },
    "claim_boundary": {
      "const": "Directional comparison on one GitHub-hosted VM; not dedicated-host evidence and not a general production-performance ranking."
    },
    "comparison_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "generated_at": { "type": "string", "minLength": 1 },
    "source": { "$ref": "#/definitions/source" },
    "runner": { "$ref": "#/definitions/runner" },
    "host": { "$ref": "#/definitions/host" },
    "ambient": { "$ref": "#/definitions/ambient" },
    "protocol": { "$ref": "#/definitions/protocol" },
    "fixture": { "$ref": "#/definitions/fixture" },
    "oracle": { "$ref": "#/definitions/oracle" },
    "targets": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/definitions/target" }
    },
    "interleaved_artifact": { "$ref": "#/definitions/interleaved_artifact" },
    "aggregates": { "type": "object" },
    "evidence_binding": { "$ref": "#/definitions/evidence_binding" }
  },
  "definitions": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision",
        "ref",
        "event_name",
        "workflow",
        "workflow_ref",
        "job",
        "run_id",
        "run_attempt",
        "repeat",
        "run_url"
      ],
      "properties": {
        "repository": { "type": "string", "pattern": "^[Oo]x[Hh][Qq]/pliego$" },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "ref": { "const": "refs/heads/main" },
        "event_name": { "const": "workflow_dispatch" },
        "workflow": { "type": "string", "minLength": 1 },
        "workflow_ref": {
          "type": "string",
          "pattern": "^[Oo]x[Hh][Qq]/pliego/\\.github/workflows/pliego-performance\\.yml@refs/heads/main$"
        },
        "job": { "type": "string", "minLength": 1 },
        "run_id": { "type": "integer", "minimum": 1 },
        "run_attempt": { "type": "integer", "minimum": 1 },
        "repeat": { "type": "integer", "minimum": 1, "maximum": 3 },
        "run_url": { "type": "string", "pattern": "^https://github\\.com/[Oo]x[Hh][Qq]/pliego/actions/runs/[1-9][0-9]*/attempts/[1-9][0-9]*$" }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "os", "arch", "environment", "image_os", "image_version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "os": { "const": "Linux" },
        "arch": { "const": "X64" },
        "environment": { "const": "github-hosted" },
        "image_os": { "type": "string", "minLength": 1 },
        "image_version": { "type": "string", "minLength": 1 }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "arch",
        "kernel",
        "cpu_model",
        "cores",
        "ram_bytes",
        "dedicated",
        "uname",
        "os_release",
        "lscpu_json",
        "virtualization",
        "cgroup"
      ],
      "properties": {
        "os": { "const": "Linux" },
        "arch": { "const": "x86_64" },
        "kernel": { "type": "string", "minLength": 1 },
        "cpu_model": { "type": "string", "minLength": 1 },
        "cores": { "type": "integer", "minimum": 1 },
        "ram_bytes": { "type": "integer", "minimum": 1 },
        "dedicated": { "const": false },
        "uname": { "type": ["string", "null"] },
        "os_release": { "type": ["string", "null"] },
        "lscpu_json": { "type": ["string", "null"] },
        "virtualization": { "type": ["string", "null"] },
        "cgroup": { "type": "object" }
      }
    },
    "ambient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after"],
      "properties": {
        "before": { "type": "object" },
        "after": { "type": "object" }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_id",
        "targets",
        "correctness_preflight_iterations",
        "warmup_iterations",
        "sample_count",
        "seed",
        "schedule_contract",
        "sample_order",
        "network",
        "measurement_method",
        "percentile_method"
      ],
      "properties": {
        "fixture_id": { "const": "minimal-static" },
        "targets": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "correctness_preflight_iterations": { "const": 1 },
        "warmup_iterations": { "const": 10 },
        "sample_count": { "type": "integer", "minimum": 100 },
        "seed": { "const": 1 },
        "schedule_contract": { "const": "pliego.cross-target-schedule.v1" },
        "sample_order": { "const": "globally-interleaved-seeded" },
        "network": { "const": "private-loopback-only" },
        "measurement_method": { "const": "linux-cgroup-v2-v1" },
        "percentile_method": { "const": "nearest-rank-v1" }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "input", "input_sha256", "bundle_sha256"],
      "properties": {
        "id": { "const": "minimal-static" },
        "input": { "type": "string", "minLength": 1 },
        "input_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bundle_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "oracle": {
      "type": "object",
      "required": [
        "contract",
        "oracle_path",
        "oracle_sha256",
        "pdfinfo_path",
        "pdfinfo_sha256",
        "pdfinfo_version",
        "pdftotext_path",
        "pdftotext_sha256",
        "pdftotext_version",
        "pdffonts_path",
        "pdffonts_sha256",
        "pdffonts_version",
        "pdftoppm_path",
        "pdftoppm_sha256",
        "pdftoppm_version"
      ],
      "properties": {
        "contract": { "const": "pliego.pdf-oracle.v1" }
      },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "engine", "runtime", "identity_sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "engine": {
          "type": "object",
          "minProperties": 6,
          "required": ["name", "version", "binary_path", "binary_sha256", "binary_bytes", "profile"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "binary_path": { "type": "string", "minLength": 1 },
            "binary_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "binary_bytes": { "type": "integer", "minimum": 1 },
            "profile": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": true
        },
        "runtime": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string" }
        },
        "identity_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "interleaved_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "artifact_sha256", "schedule_sha256"],
      "properties": {
        "file": { "const": "interleaved-run.v1.json" },
        "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "schedule_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "evidence_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "sha256"],
      "properties": {
        "contract": { "const": "pliego.hosted-comparison-evidence-binding.v1" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
