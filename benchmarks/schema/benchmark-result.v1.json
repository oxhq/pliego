{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pliego.dev/schema/benchmark-result.v1.json",
  "title": "Pliego benchmark result",
  "description": "One benchmark result, an explicit not-applicable record, or a validated multi-fixture bundle.",
  "oneOf": [
    { "$ref": "#/definitions/result" },
    { "$ref": "#/definitions/not_applicable" },
    { "$ref": "#/definitions/bundle" }
  ],
  "definitions": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "version",
        "status",
        "generated_at",
        "host",
        "toolchain",
        "protocol",
        "target",
        "fixture",
        "samples",
        "aggregates"
      ],
      "properties": {
        "schema": { "const": "pliego.benchmark-result" },
        "version": { "const": 1 },
        "generated_at": { "type": "string" },
        "status": { "type": "string", "enum": ["supported", "failed"] },
        "host": { "$ref": "#/definitions/host" },
        "toolchain": { "$ref": "#/definitions/publishable_toolchain" },
        "protocol": { "$ref": "#/definitions/protocol" },
        "target": { "$ref": "#/definitions/target" },
        "fixture": { "$ref": "#/definitions/fixture" },
        "samples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/sample" }
        },
        "aggregates": { "$ref": "#/definitions/aggregates" }
      }
    },
    "not_applicable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "version",
        "generated_at",
        "status",
        "reason",
        "host",
        "toolchain",
        "protocol",
        "target",
        "fixture"
      ],
      "properties": {
        "schema": { "const": "pliego.benchmark-result" },
        "version": { "const": 1 },
        "generated_at": { "type": "string" },
        "status": { "const": "not-applicable" },
        "reason": { "type": "string", "pattern": ".+" },
        "host": { "$ref": "#/definitions/host" },
        "toolchain": { "$ref": "#/definitions/toolchain" },
        "protocol": { "$ref": "#/definitions/not_applicable_protocol" },
        "target": { "$ref": "#/definitions/target" },
        "fixture": { "$ref": "#/definitions/fixture" }
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "version", "generated_at", "results"],
      "properties": {
        "schema": { "const": "pliego.benchmark-bundle" },
        "version": { "const": 1 },
        "generated_at": { "type": "string" },
        "results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              { "$ref": "#/definitions/result" },
              { "$ref": "#/definitions/not_applicable" }
            ]
          }
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "arch", "kernel", "cpu_model", "cores", "ram_bytes", "dedicated"],
      "properties": {
        "os": { "type": "string" },
        "arch": { "type": "string" },
        "kernel": { "type": "string" },
        "cpu_model": { "type": "string" },
        "cores": { "type": "integer", "minimum": 1 },
        "ram_bytes": { "type": "integer", "minimum": 0 },
        "dedicated": { "type": "boolean" },
        "disk_free_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "python_version", "php_version"],
      "properties": {
        "engine": { "$ref": "#/definitions/engine" },
        "python_version": { "type": "string" },
        "php_version": { "type": "string" },
        "harness_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "competitors": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "publishable_toolchain": {
      "allOf": [
        { "$ref": "#/definitions/toolchain" },
        {
          "required": ["harness_revision", "competitors"],
          "properties": {
            "competitors": { "type": "object", "minProperties": 1 }
          }
        }
      ]
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "commit": { "type": "string" },
        "release_tag": { "type": "string" },
        "servo_build": { "type": "string" },
        "servo_base": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "package": { "type": "string" },
        "binary_path": { "type": "string" },
        "binary_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "binary_bytes": { "type": "integer", "minimum": 0 },
        "bundle": { "type": "string" },
        "bundle_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bundle_bytes": { "type": "integer", "minimum": 1 },
        "profile": { "type": "string" }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "warmup_iterations",
        "correctness_preflight_iterations",
        "execution_order",
        "sample_count",
        "sample_order",
        "network",
        "binary_profile",
        "measurement_method",
        "percentile_method"
      ],
      "properties": {
        "warmup_iterations": { "type": "integer", "minimum": 0 },
        "correctness_preflight_iterations": { "type": "integer", "minimum": 0 },
        "execution_order": {
          "type": "string",
          "enum": ["untimed-correctness-preflight,warmup,timed"]
        },
        "sample_count": { "type": "integer", "minimum": 1 },
        "sample_order": { "type": "string", "enum": ["random", "sequential"] },
        "seed": { "type": "integer" },
        "network": { "const": "disabled" },
        "binary_profile": { "type": "string" },
        "measurement_method": { "type": "string", "enum": ["linux-cgroup-v2-v1", "unavailable"] },
        "percentile_method": { "const": "nearest-rank-v1" }
      }
    },
    "not_applicable_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "warmup_iterations",
        "sample_count",
        "sample_order",
        "network",
        "binary_profile",
        "measurement_method",
        "percentile_method"
      ],
      "properties": {
        "warmup_iterations": { "type": "integer", "minimum": 0 },
        "sample_count": { "const": 0 },
        "sample_order": { "type": "string", "enum": ["random", "sequential"] },
        "seed": { "type": "integer" },
        "network": { "const": "disabled" },
        "binary_profile": { "type": "string" },
        "measurement_method": { "const": "unavailable" },
        "percentile_method": { "const": "nearest-rank-v1" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "purpose", "category", "input"],
      "properties": {
        "id": { "type": "string" },
        "purpose": { "type": "string" },
        "category": {
          "type": "string",
          "enum": ["static", "scripted", "scale", "resources", "failure"]
        },
        "input": { "type": "string" },
        "input_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bundle_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "expected_page_count": { "type": ["integer", "null"], "minimum": 1 },
        "expected_page_width_points": { "type": ["number", "null"], "minimum": 0 },
        "expected_page_height_points": { "type": ["number", "null"], "minimum": 0 },
        "dimension_tolerance_points": { "type": ["number", "null"], "minimum": 0 },
        "expected_text_contains": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "expected_text": { "type": ["string", "null"] },
        "expected_font_families": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "expected_normalized_raster_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "expected_link_targets": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "expected_failure_code": { "type": ["string", "null"] }
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "ok",
        "exit_code",
        "wall_ms",
        "one_shot_wall_ms",
        "user_ms",
        "sys_ms",
        "memory_current_bytes",
        "memory_peak_bytes",
        "sampled_peak_rss_kib_lower_bound",
        "sampled_peak_pss_kib_lower_bound",
        "read_bytes",
        "write_bytes",
        "read_operations",
        "write_operations",
        "measurement_method",
        "signal",
        "resource_usage",
        "output",
        "correctness",
        "failure"
      ],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "ok": { "type": "boolean" },
        "exit_code": { "type": "integer" },
        "wall_ms": { "type": "number", "minimum": 0 },
        "one_shot_wall_ms": { "type": "number", "minimum": 0 },
        "user_ms": { "type": ["number", "null"], "minimum": 0 },
        "sys_ms": { "type": ["number", "null"], "minimum": 0 },
        "memory_current_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "memory_peak_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "sampled_peak_rss_kib_lower_bound": { "type": ["integer", "null"], "minimum": 0 },
        "sampled_peak_pss_kib_lower_bound": { "type": ["integer", "null"], "minimum": 0 },
        "read_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "write_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "read_operations": { "type": ["integer", "null"], "minimum": 0 },
        "write_operations": { "type": ["integer", "null"], "minimum": 0 },
        "measurement_method": { "type": "string", "enum": ["linux-cgroup-v2-v1", "unavailable"] },
        "signal": { "type": ["integer", "null"], "minimum": 1 },
        "resource_usage": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/definitions/resource_usage" }
          ]
        },
        "phase_timings_ms": {
          "type": ["object", "null"],
          "additionalProperties": { "type": "number", "minimum": 0 }
        },
        "bridge_timings_ms": {
          "type": ["object", "null"],
          "additionalProperties": { "type": "number", "minimum": 0 }
        },
        "bridge_timings": { "$ref": "#/definitions/bridge_timings" },
        "retained": { "$ref": "#/definitions/retained" },
        "output": { "$ref": "#/definitions/output" },
        "correctness": { "$ref": "#/definitions/correctness" },
        "failure": { "$ref": "#/definitions/failure" },
        "summary": { "type": ["object", "null"] }
      }
    },
    "bridge_timings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "version",
        "measurement_boundary",
        "total_ms",
        "native_engine_ms",
        "bridge_overhead_ms",
        "setup_ms",
        "phases_ms",
        "unavailable",
        "notes",
        "diagnostics"
      ],
      "properties": {
        "schema": { "const": "pliego.php-bridge-timings" },
        "version": { "const": 1 },
        "measurement_boundary": { "const": "render-invocation-before-timing-diagnostics" },
        "total_ms": { "type": "number", "minimum": 0 },
        "native_engine_ms": { "type": ["number", "null"], "minimum": 0 },
        "bridge_overhead_ms": { "type": ["number", "null"], "minimum": 0 },
        "setup_ms": {
          "type": "object",
          "additionalProperties": false,
          "required": ["runtime_resolution", "runtime_install"],
          "properties": {
            "runtime_resolution": { "type": ["number", "null"], "minimum": 0 },
            "runtime_install": { "type": ["number", "null"], "minimum": 0 }
          }
        },
        "phases_ms": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "laravel_setup",
            "view_render",
            "bundle_staging",
            "asset_manifest_hash",
            "process_launch",
            "stdin_stdout",
            "native_wait",
            "result_parse",
            "publication_copy",
            "cleanup",
            "unattributed"
          ],
          "properties": {
            "laravel_setup": { "type": ["number", "null"], "minimum": 0 },
            "view_render": { "type": ["number", "null"], "minimum": 0 },
            "bundle_staging": { "type": "number", "minimum": 0 },
            "asset_manifest_hash": { "type": "number", "minimum": 0 },
            "process_launch": { "type": "number", "minimum": 0 },
            "stdin_stdout": { "type": "number", "minimum": 0 },
            "native_wait": { "type": "number", "minimum": 0 },
            "result_parse": { "type": "number", "minimum": 0 },
            "publication_copy": { "type": ["number", "null"], "minimum": 0 },
            "cleanup": { "type": "number", "minimum": 0 },
            "unattributed": { "type": "number", "minimum": 0 }
          }
        },
        "unavailable": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "notes": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "diagnostics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["retained"],
          "properties": {
            "retained": { "type": "boolean" }
          }
        }
      }
    },
    "resource_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "scope",
        "delegated_parent",
        "cgroup_path",
        "root_pid",
        "root_start_ticks",
        "launch_security",
        "wall_ms",
        "exit_code",
        "signal",
        "cpu_user_ms",
        "cpu_sys_ms",
        "memory_current_bytes",
        "memory_peak_bytes",
        "read_bytes",
        "write_bytes",
        "read_operations",
        "write_operations",
        "cgroup_drained",
        "drain_ms",
        "accounting_settle",
        "cleanup",
        "counters",
        "sampled_diagnostics",
        "sampler_cpu_user_ms",
        "sampler_cpu_sys_ms",
        "sampler_cpu_percent_of_wall"
      ],
      "properties": {
        "method": { "const": "linux-cgroup-v2-v1" },
        "scope": { "const": "fresh-root-owned-cgroup-subtree" },
        "delegated_parent": { "type": "string" },
        "cgroup_path": { "type": "string" },
        "root_pid": { "type": "integer", "minimum": 1 },
        "root_start_ticks": { "type": "integer", "minimum": 1 },
        "launch_security": { "$ref": "#/definitions/launch_security" },
        "wall_ms": { "type": "number", "minimum": 0 },
        "exit_code": { "type": "integer" },
        "signal": { "type": ["integer", "null"], "minimum": 1 },
        "cpu_user_ms": { "type": "number", "minimum": 0 },
        "cpu_sys_ms": { "type": "number", "minimum": 0 },
        "memory_current_bytes": { "type": "integer", "minimum": 0 },
        "memory_peak_bytes": { "type": "integer", "minimum": 0 },
        "read_bytes": { "type": "integer", "minimum": 0 },
        "write_bytes": { "type": "integer", "minimum": 0 },
        "read_operations": { "type": "integer", "minimum": 0 },
        "write_operations": { "type": "integer", "minimum": 0 },
        "cgroup_drained": { "const": true },
        "drain_ms": { "type": "number", "minimum": 0 },
        "accounting_settle": { "$ref": "#/definitions/accounting_settle" },
        "cleanup": { "$ref": "#/definitions/cgroup_cleanup" },
        "counters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["empty", "after_join", "final"],
          "properties": {
            "empty": { "$ref": "#/definitions/cgroup_counters" },
            "after_join": { "$ref": "#/definitions/cgroup_counters" },
            "final": { "$ref": "#/definitions/cgroup_counters" }
          }
        },
        "sampled_diagnostics": { "$ref": "#/definitions/sampled_diagnostics" },
        "sampler_cpu_user_ms": { "type": "number", "minimum": 0 },
        "sampler_cpu_sys_ms": { "type": "number", "minimum": 0 },
        "sampler_cpu_percent_of_wall": { "type": "number", "minimum": 0 }
      }
    },
    "launch_security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["account", "uid", "gid", "argv", "executable", "status", "migration_write_probes", "temporary_storage"],
      "properties": {
        "account": { "const": "pliego-benchmark-engine" },
        "uid": { "type": "integer", "minimum": 1 },
        "gid": { "type": "integer", "minimum": 1 },
        "argv": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        },
        "executable": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "device", "inode"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "device": { "type": "integer", "minimum": 0 },
            "inode": { "type": "integer", "minimum": 1 }
          }
        },
        "status": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "uid",
            "gid",
            "supplementary_groups",
            "cap_inheritable_hex",
            "cap_permitted_hex",
            "cap_effective_hex",
            "cap_bounding_hex",
            "cap_ambient_hex",
            "no_new_privs"
          ],
          "properties": {
            "uid": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "integer", "minimum": 1 } },
            "gid": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "integer", "minimum": 1 } },
            "supplementary_groups": { "type": "array", "maxItems": 0 },
            "cap_inheritable_hex": { "type": "string", "pattern": "^0+$" },
            "cap_permitted_hex": { "type": "string", "pattern": "^0+$" },
            "cap_effective_hex": { "type": "string", "pattern": "^0+$" },
            "cap_bounding_hex": { "type": "string", "pattern": "^0+$" },
            "cap_ambient_hex": { "type": "string", "pattern": "^0+$" },
            "no_new_privs": { "const": 1 }
          }
        },
        "migration_write_probes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["parent", "harness", "staging", "measurement"],
          "properties": {
            "parent": { "$ref": "#/definitions/migration_denials" },
            "harness": { "$ref": "#/definitions/migration_denials" },
            "staging": { "$ref": "#/definitions/migration_denials" },
            "measurement": { "$ref": "#/definitions/migration_denials" }
          }
        },
        "temporary_storage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["directory_sync", "filesystem", "scope"],
          "properties": {
            "directory_sync": { "const": "FS_DIRSYNC_FL" },
            "filesystem": { "const": "ext4" },
            "scope": { "const": "per-invocation-private" }
          }
        },
        "network_isolation": {
          "$ref": "#/definitions/network_isolation"
        }
      }
    },
    "network_isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "host_namespace", "engine_namespace", "interfaces"],
      "properties": {
        "mode": { "const": "linux-private-network-namespace-v1" },
        "host_namespace": { "type": "string", "pattern": "^net:\\[[0-9]+\\]$" },
        "engine_namespace": { "type": "string", "pattern": "^net:\\[[0-9]+\\]$" },
        "interfaces": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "const": "lo" }
        }
      }
    },
    "migration_denials": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cgroup.procs", "cgroup.threads"],
      "properties": {
        "cgroup.procs": { "enum": ["EACCES", "EPERM"] },
        "cgroup.threads": { "enum": ["EACCES", "EPERM"] }
      }
    },
    "accounting_settle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "poll_interval_ms",
        "timeout_ms",
        "duration_ms",
        "reads",
        "stable_reads",
        "stable_observations"
      ],
      "properties": {
        "poll_interval_ms": { "type": "number", "minimum": 0 },
        "timeout_ms": { "type": "number", "minimum": 0 },
        "duration_ms": { "type": "number", "minimum": 0 },
        "reads": { "type": "integer", "minimum": 2 },
        "stable_reads": { "const": 2 },
        "stable_observations": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/definitions/settle_observation" }
        }
      }
    },
    "settle_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu_stat", "io_stat", "memory_file_dirty_bytes", "memory_file_writeback_bytes"],
      "properties": {
        "cpu_stat": { "$ref": "#/definitions/cpu_stat" },
        "io_stat": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/io_stat_device" }
        },
        "memory_file_dirty_bytes": { "const": 0 },
        "memory_file_writeback_bytes": { "const": 0 }
      }
    },
    "cgroup_cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kill_used", "kill_grace_ms", "lingering_before_kill"],
      "properties": {
        "kill_used": { "type": "boolean" },
        "kill_grace_ms": { "type": "number", "minimum": 0 },
        "lingering_before_kill": {
          "type": "array",
          "items": { "$ref": "#/definitions/process_identity" }
        }
      }
    },
    "process_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pid", "start_ticks"],
      "properties": {
        "pid": { "type": "integer", "minimum": 1 },
        "start_ticks": { "type": "integer", "minimum": 1 }
      }
    },
    "cgroup_counters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu_stat",
        "io_stat",
        "memory_current_bytes",
        "memory_peak_bytes",
        "memory_file_dirty_bytes",
        "memory_file_writeback_bytes",
        "pids_peak",
        "cgroup_events"
      ],
      "properties": {
        "cpu_stat": { "$ref": "#/definitions/cpu_stat" },
        "io_stat": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/io_stat_device" }
        },
        "memory_current_bytes": { "type": "integer", "minimum": 0 },
        "memory_peak_bytes": { "type": "integer", "minimum": 0 },
        "memory_file_dirty_bytes": { "type": "integer", "minimum": 0 },
        "memory_file_writeback_bytes": { "type": "integer", "minimum": 0 },
        "pids_peak": { "type": "integer", "minimum": 0 },
        "cgroup_events": { "$ref": "#/definitions/cgroup_events" }
      }
    },
    "cpu_stat": {
      "type": "object",
      "required": ["usage_usec", "user_usec", "system_usec"],
      "properties": {
        "usage_usec": { "type": "integer", "minimum": 0 },
        "user_usec": { "type": "integer", "minimum": 0 },
        "system_usec": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "io_stat_device": {
      "type": "object",
      "required": ["rbytes", "wbytes", "rios", "wios"],
      "properties": {
        "rbytes": { "type": "integer", "minimum": 0 },
        "wbytes": { "type": "integer", "minimum": 0 },
        "rios": { "type": "integer", "minimum": 0 },
        "wios": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "cgroup_events": {
      "type": "object",
      "required": ["populated", "frozen"],
      "properties": {
        "populated": { "type": "integer", "enum": [0, 1] },
        "frozen": { "type": "integer", "enum": [0, 1] }
      },
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "sampled_diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverage",
        "sample_interval_ms",
        "pss_interval_ms",
        "page_size_bytes",
        "max_sample_gap_ms",
        "sampled_peak_summed_rss_kib_lower_bound",
        "sampled_peak_summed_pss_kib_lower_bound",
        "observed_processes",
        "samples"
      ],
      "properties": {
        "coverage": {
          "const": "periodic post-exec cgroup membership snapshots; RSS and PSS peaks are lower bounds and may miss processes shorter than the interval"
        },
        "sample_interval_ms": { "type": "number", "minimum": 0 },
        "pss_interval_ms": { "type": "number", "minimum": 0 },
        "page_size_bytes": { "type": "integer", "minimum": 1 },
        "max_sample_gap_ms": { "type": "number", "minimum": 0 },
        "sampled_peak_summed_rss_kib_lower_bound": { "type": "integer", "minimum": 0 },
        "sampled_peak_summed_pss_kib_lower_bound": { "type": ["integer", "null"], "minimum": 0 },
        "observed_processes": {
          "type": "array",
          "items": { "$ref": "#/definitions/observed_process" }
        },
        "samples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/diagnostic_sample" }
        }
      }
    },
    "observed_process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pid", "start_ticks", "first_seen_ms", "last_seen_ms"],
      "properties": {
        "pid": { "type": "integer", "minimum": 1 },
        "start_ticks": { "type": "integer", "minimum": 1 },
        "first_seen_ms": { "type": "number", "minimum": 0 },
        "last_seen_ms": { "type": "number", "minimum": 0 }
      }
    },
    "diagnostic_sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elapsed_ms",
        "cgroup_memory_current_bytes",
        "sampled_summed_rss_kib_lower_bound",
        "sampled_summed_pss_kib_lower_bound",
        "processes"
      ],
      "properties": {
        "elapsed_ms": { "type": "number", "minimum": 0 },
        "cgroup_memory_current_bytes": { "type": "integer", "minimum": 0 },
        "sampled_summed_rss_kib_lower_bound": { "type": "integer", "minimum": 0 },
        "sampled_summed_pss_kib_lower_bound": { "type": ["integer", "null"], "minimum": 0 },
        "processes": {
          "type": "array",
          "items": { "$ref": "#/definitions/diagnostic_sample_process" }
        }
      }
    },
    "diagnostic_sample_process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pid", "start_ticks", "rss_pages", "pss_kib"],
      "properties": {
        "pid": { "type": "integer", "minimum": 1 },
        "start_ticks": { "type": "integer", "minimum": 1 },
        "rss_pages": { "type": "integer", "minimum": 0 },
        "pss_kib": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "retained": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output_dir", "artifacts_dir"],
      "properties": {
        "output_dir": { "type": "string" },
        "artifacts_dir": { "type": "string" }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pdf_bytes",
        "pdf_sha256",
        "page_count",
        "artifact_bytes",
        "published_pdf",
        "normalized_text_sha256",
        "font_families",
        "normalized_raster_sha256"
      ],
      "properties": {
        "pdf_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "pdf_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "page_count": { "type": ["integer", "null"], "minimum": 1 },
        "page_dimensions_points": {
          "type": ["array", "null"],
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "number", "minimum": 0 }
          }
        },
        "normalized_text_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "font_families": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "normalized_raster_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "artifact_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "published_pdf": { "type": "boolean" }
      }
    },
    "correctness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass", "checks"],
      "properties": {
        "pass": { "type": "boolean" },
        "checks": {
          "type": "array",
          "items": { "$ref": "#/definitions/check" }
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status"],
      "properties": {
        "name": { "type": "string" },
        "status": { "type": "string", "enum": ["pass", "fail", "unverified"] },
        "detail": { "type": "string" }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "published_pdf"],
      "properties": {
        "code": { "type": ["string", "null"] },
        "message": { "type": ["string", "null"] },
        "published_pdf": { "type": "boolean" }
      }
    },
    "aggregates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latency", "cpu", "memory", "io", "output", "correctness", "determinism", "failures"],
      "properties": {
        "latency": { "$ref": "#/definitions/percentiles" },
        "cpu": {
          "type": "object",
          "additionalProperties": false,
          "required": ["user_ms", "sys_ms", "wall_ms"],
          "properties": {
            "user_ms": { "$ref": "#/definitions/percentiles" },
            "sys_ms": { "$ref": "#/definitions/percentiles" },
            "wall_ms": { "$ref": "#/definitions/percentiles" }
          }
        },
        "memory": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cgroup_peak_bytes", "sampled_peak_rss_kib_lower_bound"],
          "properties": {
            "cgroup_peak_bytes": { "$ref": "#/definitions/percentiles" },
            "sampled_peak_rss_kib_lower_bound": { "$ref": "#/definitions/percentiles" },
            "sampled_peak_pss_kib_lower_bound": { "$ref": "#/definitions/percentiles" }
          }
        },
        "io": {
          "type": "object",
          "additionalProperties": false,
          "required": ["read_bytes", "write_bytes", "read_operations", "write_operations"],
          "properties": {
            "read_bytes": { "$ref": "#/definitions/percentiles" },
            "write_bytes": { "$ref": "#/definitions/percentiles" },
            "read_operations": { "$ref": "#/definitions/percentiles" },
            "write_operations": { "$ref": "#/definitions/percentiles" }
          }
        },
        "scaling": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "per_page_wall_ms": { "type": "number", "minimum": 0 },
            "per_page_memory_peak_bytes": { "type": "number", "minimum": 0 }
          }
        },
        "throughput": {
          "type": "object",
          "additionalProperties": false,
          "required": ["renders_per_minute", "concurrency", "mean_one_shot_wall_ms", "measurement_boundary"],
          "properties": {
            "renders_per_minute": { "type": "number", "minimum": 0 },
            "concurrency": { "type": "integer", "minimum": 1 },
            "mean_one_shot_wall_ms": { "type": "number", "exclusiveMinimum": 0 },
            "measurement_boundary": { "const": "runner-process-open-through-sampler-exit" }
          }
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pdf_bytes", "page_count"],
          "properties": {
            "pdf_bytes": { "$ref": "#/definitions/percentiles" },
            "page_count": { "type": ["integer", "null"], "minimum": 1 }
          }
        },
        "correctness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pass_count", "total", "passed"],
          "properties": {
            "pass_count": { "type": "integer", "minimum": 0 },
            "total": { "type": "integer", "minimum": 0 },
            "passed": { "type": "boolean" }
          }
        },
        "determinism": {
          "type": "object",
          "additionalProperties": false,
          "required": ["identical_pdf_sha256", "total", "pdf_sha256_variants"],
          "properties": {
            "identical_pdf_sha256": { "type": "integer", "minimum": 0 },
            "total": { "type": "integer", "minimum": 0 },
            "pdf_sha256_variants": { "type": "integer", "minimum": 0 }
          }
        },
        "failures": {
          "type": "object",
          "additionalProperties": false,
          "required": ["count"],
          "properties": {
            "count": { "type": "integer", "minimum": 0 },
            "codes": {
              "type": "object",
              "additionalProperties": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "percentiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "p50", "p95", "p99", "max", "mean"],
      "properties": {
        "min": { "type": "number" },
        "p50": { "type": "number" },
        "p95": { "type": "number" },
        "p99": { "type": "number" },
        "max": { "type": "number" },
        "mean": { "type": "number" }
      }
    }
  }
}
