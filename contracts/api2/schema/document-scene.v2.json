{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pliego.dev/schema/document-scene.v2.json",
  "title": "Pliego public DocumentScene",
  "description": "The ordered, fixed-point, path-independent public scene artifact for API 2.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "app_units_per_css_px",
    "request_page",
    "semantic_layer",
    "pages"
  ],
  "properties": {
    "schema": { "const": "pliego.document-scene" },
    "version": { "const": 2 },
    "app_units_per_css_px": { "const": 60 },
    "request_page": { "$ref": "render-request.v1.json#/definitions/page" },
    "semantic_layer": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/definitions/semantic_layer_ref" }
      ]
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4294967295,
      "items": { "$ref": "#/definitions/page" }
    }
  },
  "definitions": {
    "content_address": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "unsigned_32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "finite_f32_bits": {
      "description": "Canonical IEEE-754 binary32 bits: finite values and positive zero only.",
      "oneOf": [
        { "type": "integer", "minimum": 0, "maximum": 2139095039 },
        { "type": "integer", "minimum": 2147483649, "maximum": 4286578687 }
      ]
    },
    "font_variation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "value_f32_bits"],
      "properties": {
        "tag": { "$ref": "#/definitions/unsigned_32" },
        "value_f32_bits": { "$ref": "#/definitions/finite_f32_bits" }
      }
    },
    "font_instance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource", "face_index", "variations", "synthetic_bold"],
      "properties": {
        "resource": { "$ref": "#/definitions/content_address" },
        "face_index": { "$ref": "#/definitions/unsigned_32" },
        "variations": {
          "type": "array",
          "maxItems": 4294967295,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/font_variation" }
        },
        "synthetic_bold": { "type": "boolean" }
      }
    },
    "semantic_layer_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "version", "profile", "resource", "media_type"],
      "properties": {
        "schema": {
          "type": "string",
          "pattern": "^pliego\\.document-semantics\\.[a-z0-9][a-z0-9.-]{0,127}$"
        },
        "version": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "profile": { "$ref": "render-request.v1.json#/definitions/profile_ref" },
        "resource": { "$ref": "#/definitions/content_address" },
        "media_type": { "const": "application/vnd.pliego.document-semantics+json" }
      }
    },
    "signed_app_unit": {
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 2147483647
    },
    "nonnegative_app_unit": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "positive_app_unit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "style_source", "size_app_units", "margins_app_units", "operations"],
      "properties": {
        "number": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "style_source": { "const": "request-defaults" },
        "size_app_units": { "$ref": "#/definitions/size" },
        "margins_app_units": { "$ref": "render-request.v1.json#/definitions/margins" },
        "operations": {
          "type": "array",
          "maxItems": 4294967295,
          "items": { "$ref": "#/definitions/operation" }
        }
      }
    },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "$ref": "#/definitions/positive_app_unit" },
        "height": { "$ref": "#/definitions/positive_app_unit" }
      }
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "$ref": "#/definitions/signed_app_unit" },
        "y": { "$ref": "#/definitions/signed_app_unit" },
        "width": { "$ref": "#/definitions/nonnegative_app_unit" },
        "height": { "$ref": "#/definitions/nonnegative_app_unit" }
      }
    },
    "color_rgba8": {
      "type": "object",
      "additionalProperties": false,
      "required": ["r", "g", "b", "a"],
      "properties": {
        "r": { "type": "integer", "minimum": 0, "maximum": 255 },
        "g": { "type": "integer", "minimum": 0, "maximum": 255 },
        "b": { "type": "integer", "minimum": 0, "maximum": 255 },
        "a": { "type": "integer", "minimum": 0, "maximum": 255 }
      }
    },
    "stroke": {
      "type": "object",
      "additionalProperties": false,
      "required": ["color", "width_app_units"],
      "properties": {
        "color": { "$ref": "#/definitions/color_rgba8" },
        "width_app_units": { "$ref": "#/definitions/positive_app_unit" }
      }
    },
    "text_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "end": { "type": "integer", "minimum": 1, "maximum": 4294967295 }
      }
    },
    "glyph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "x", "y", "advance", "text_range"],
      "properties": {
        "id": { "$ref": "#/definitions/unsigned_32" },
        "x": { "$ref": "#/definitions/signed_app_unit" },
        "y": { "$ref": "#/definitions/signed_app_unit" },
        "advance": { "$ref": "#/definitions/signed_app_unit" },
        "text_range": { "$ref": "#/definitions/text_range" }
      }
    },
    "operation": {
      "oneOf": [
        { "$ref": "#/definitions/text_operation" },
        { "$ref": "#/definitions/path_operation" },
        { "$ref": "#/definitions/image_operation" },
        { "$ref": "#/definitions/link_operation" }
      ]
    },
    "text_operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text", "font", "font_size_app_units", "color", "glyphs"],
      "properties": {
        "type": { "const": "text" },
        "text": { "type": "string", "minLength": 1, "maxLength": 4294967295 },
        "font": { "$ref": "#/definitions/font_instance" },
        "font_size_app_units": { "$ref": "#/definitions/positive_app_unit" },
        "color": { "$ref": "#/definitions/color_rgba8" },
        "glyphs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4294967295,
          "items": { "$ref": "#/definitions/glyph" }
        }
      }
    },
    "path_data": {
      "type": "string",
      "minLength": 5,
      "maxLength": 16777216,
      "description": "Canonical absolute SVG subset: uppercase M, L, Q, C, Z; one ASCII space; base-10 i32; no commas, plus signs, leading zeros, or negative zero.",
      "pattern": "^M (?:0|-?[1-9][0-9]*) (?:0|-?[1-9][0-9]*)(?: (?:M (?:0|-?[1-9][0-9]*) (?:0|-?[1-9][0-9]*)|L (?:0|-?[1-9][0-9]*) (?:0|-?[1-9][0-9]*)|Q (?:0|-?[1-9][0-9]*) (?:0|-?[1-9][0-9]*) (?:0|-?[1-9][0-9]*) (?:0|-?[1-9][0-9]*)|C (?:0|-?[1-9][0-9]*) (?:0|-?[1-9][0-9]*) (?:0|-?[1-9][0-9]*) (?:0|-?[1-9][0-9]*) (?:0|-?[1-9][0-9]*) (?:0|-?[1-9][0-9]*)|Z))*$"
    },
    "path_operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "bounds", "data", "fill_rule"],
      "anyOf": [
        { "required": ["fill"] },
        { "required": ["stroke"] }
      ],
      "properties": {
        "type": { "const": "path" },
        "bounds": { "$ref": "#/definitions/rect" },
        "data": { "$ref": "#/definitions/path_data" },
        "fill": { "$ref": "#/definitions/color_rgba8" },
        "fill_rule": { "type": "string", "enum": ["non-zero", "even-odd"] },
        "stroke": { "$ref": "#/definitions/stroke" }
      }
    },
    "image_operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "bounds", "resource", "media_type"],
      "properties": {
        "type": { "const": "image" },
        "bounds": { "$ref": "#/definitions/rect" },
        "resource": { "$ref": "#/definitions/content_address" },
        "media_type": {
          "type": "string",
          "enum": ["image/gif", "image/jpeg", "image/png", "image/webp"]
        }
      }
    },
    "link_operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "bounds", "target"],
      "properties": {
        "type": { "const": "link" },
        "bounds": { "$ref": "#/definitions/rect" },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "^(?:https?://|mailto:)[^\\s]+$"
        }
      }
    }
  }
}
