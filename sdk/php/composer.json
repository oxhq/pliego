{
    "name": "oxhq/pliego-php",
    "description": "PHP client for one-shot Pliego document rendering",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3"
    },
    "autoload": {
        "psr-4": {
            "Pliego\\Php\\": "src/"
        }
    },
    "scripts": {
        "test:api2": "@php tests/api2_contract_test.php",
        "test:doctor": "@php tests/doctor_test.php",
        "test:timings": "@php tests/bridge_timings_test.php",
        "test": [
            "@test:api2",
            "@test:timings",
            "@php tests/self_test.php",
            "@php tests/timeout_test.php",
            "@php tests/retention_test.php",
            "@php tests/doctor_test.php",
            "@php examples/check-resource-modes.php"
        ]
    }
}
