{
    "name": "oxhq/pliego-php",
    "description": "Experimental one-shot PHP bridge for the Pliego document engine",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3"
    },
    "autoload": {
        "psr-4": {
            "Pliego\\Php\\Experimental\\": "src/"
        }
    },
    "scripts": {
        "test:doctor": "@php tests/doctor_test.php",
        "test": [
            "@php tests/self_test.php",
            "@php tests/timeout_test.php",
            "@php tests/retention_test.php",
            "@php tests/doctor_test.php"
        ]
    }
}
