{
    "name": "oxhq/pliego-laravel",
    "description": "Experimental Laravel bridge for one-shot Pliego CLI rendering",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/view": "^13.0",
        "oxhq/pliego-php": "0.1.0-alpha.1",
        "symfony/http-foundation": "^7.4 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Pliego\\Laravel\\Experimental\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Pliego\\Laravel\\Experimental\\PliegoServiceProvider"
            ]
        }
    }
}
