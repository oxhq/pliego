{
    "name": "oxhq/pliego-laravel",
    "description": "Laravel integration for native Pliego document rendering",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/view": "^12.0 || ^13.0",
        "league/flysystem": "^3.25.1",
        "oxhq/pliego-php": "0.4.0",
        "symfony/http-foundation": "^7.2 || ^8.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Pliego\\Laravel\\": "src/"
        }
    },
    "scripts": {
        "release:check-runtime": "@php tests/release_runtime_manifest_test.php",
        "test:runtime": "@php tests/managed_runtime_test.php",
        "test:quickstart": "@php tests/quickstart_test.php",
        "test:timings": "@php tests/bridge_timings_test.php",
        "test:storage": "@php tests/storage_test.php",
        "test:framework": "@php tests/framework_compatibility_test.php",
        "test": ["@test:runtime", "@test:quickstart", "@test:timings", "@test:storage"]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Pliego\\Laravel\\PliegoServiceProvider"
            ]
        }
    }
}
