APP_NAME="Pliego Laravel invoice fixture"
APP_ENV=testing
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_DEBUG=true
APP_URL=http://localhost
LOG_CHANNEL=stderr
# Optional escape hatch: PLIEGO_BINARY=/absolute/path/to/pliego
PLIEGO_LOCALE=es-MX
PLIEGO_TIMEZONE=PST8PDT
PLIEGO_PAGE_SIZE=612x792
PLIEGO_PAGE_MARGINS=36,36,36,36
