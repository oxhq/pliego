{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "oxhq/pliego-laravel-invoice-fixture",
    "description": "Pinned Laravel 13 invoice fixture for Pliego rendering",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "../../../sdk/php",
            "options": {
                "symlink": true,
                "versions": {
                    "oxhq/pliego-php": "0.3.2"
                }
            }
        },
        {
            "type": "path",
            "url": "../../../sdk/laravel",
            "options": {
                "symlink": true,
                "versions": {
                    "oxhq/pliego-laravel": "0.3.2"
                }
            }
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "13.22.0",
        "oxhq/pliego-laravel": "0.3.2"
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "render": "@php artisan pliego:invoice",
        "rehearse": "@php artisan pliego:rehearse-queue",
        "rehearse:self-test": "@php rehearsal.php --self-test",
        "verify": "@php verify.php"
    },
    "config": {
        "allow-plugins": {},
        "optimize-autoloader": true,
        "platform": {
            "php": "8.3.0"
        },
        "preferred-install": "dist",
        "sort-packages": true
    }
}
